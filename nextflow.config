// nextflow.config

//main options to change
params.outdir = "${baseDir}/results"
params.deacon_index = '../databases/deacon_index/panhuman-1.k31w15.idx'
params.nohuman_db = '../databases/nohuman/'
params.sylph_95_db = '../databases/sylph_databases/gtdb_95_DB/gtdb-r220-c200-dbv1.syldb'
params.sylph_99_db = '../databases/sylph_databases/gtdb_99_ordered_DB/gtdb_ordered_99.syldb'
params.kraken2_db = '../databases/kraken2_database/'
params.tracs_refseqs = '../databases/gtdb_genomes_reps_r220/database'
params.tracs_database = '../databases/gtdb-reps-rs220-k51.sbt.zip'
// TRACS_GATHER still records work_units (references x input GB) per sample in
// results/metadata/tracs_sizing*.tsv. Since the read screen (see main.nf TRACS_ALIGN) the
// alignment no longer scales with that product, so the old work_units-based tiering
// (tracs_work_boost / tracs_work_long) is gone; re-fit from the sizing tsv against
// observed runtimes if a new model is wanted.
workDir = "${baseDir}/work"



//enables apptainer support
singularity {
    enabled = true
    autoMounts = true
    cacheDir  = "${baseDir}/singularity"
    envWhitelist = 'SINGULARITY_BINDPATH, SINGULARITYENV_LD_LIBRARY_PATH, SINGULARITYENV_LD_PRELOAD'
    }

//intermediary file cleanup using nf-boost; does not work consistently on slurm :(
/*plugins {
  id 'nf-boost'
}
boost {
  cleanup = 'v2'
}
boost.cleanupInterval = '180s'*/

//cleanup = true //enables nextflow built-in cleanup
executor {
    exitReadTimeout   = '30 min'
    queueStatInterval = '2 min'
    pollInterval      = '30 sec'
    submitRateLimit   = '20/1min'   // also addresses the 23 submit failures
    queueSize = 1024
}

params.slurm_account = 'pawsey1172'
// Slurm executor settings
process {
  cache = 'lenient' //apparently important in pawsey due to lustre?
  stageInMode = 'symlink'
  executor = 'slurm'
  clusterOptions = "--account=${params.slurm_account}"
  errorStrategy = 'ignore'
  beforeScript = 'module load pawseyenv/2025.08 && module load singularity/4.1.0-slurm' //load singularity on each job before running
  // Set resource requests
  cpus = 8
  memory = '16 GB'
  time = '30min'
  //container settings
  
  withName: KINGFISHER_ANNOTATE {
        container = 'zunairkhm/kingfisher-ascp:v1.0'
        cpus = 1
        memory = '4 GB'
        time = '1h'
    }
  withName: KINGFISHER_GET {
        //clusterOptions = "--partition=copy" //use copy partition for data transfer
        container = 'zunairkhm/kingfisher-ascp:v1.0'
        cpus = 8
        memory = '16 GB'
        // stay at 30min on every attempt unless the previous one was killed for running
        // out of walltime (signal exit codes 130-145, same range TRACS_ALIGN matches) -
        // a non-timeout failure (e.g. exit 1, access denied) won't be fixed by more time
        time = { task.exitStatus in (130..145) ? '1d' : '30m' }

    }
    withName: DEACON_FILTER {
        container = 'zunairkhm/deacon-image:v1.0'
    }
    withName: NOHUMAN_FILTER {
        container = 'zunairkhm/nohuman-image:v1.0'
        time = '1h'
        // the HPRC.r2 kraken2 database is 5.9GB and is held in memory: 8GB was OOM-killed
        // (MaxRSS 8.4GB) on 3-10GB samples in the Oct 2026 validation run
        memory = '16 GB'
    }
    withName: SYLPH_QUERY {
        memory = '32 GB'
    }
    withName: KRAKEN2_KRAKEN2 {
    cpus = 16
    memory = '110 GB'
    time = '2h'
    container = 'quay.io/biocontainers/kraken2:2.1.3--pl5321hdcf5f25_0'
}
    withName: TRACS_GATHER {
        container = 'zunairkhm/tracs-align:v4.0'
        cpus = 8   // nominal - see the note on TRACS_ALIGN below
        // fastgather (TRACS_FASTGATHER=1, see main.nf), as batches 00-06 used. sacct over the
        // 3.6k batch04/05 fastgathers at 32GB (~36 cores billed): sketch + gather mean 5 min,
        // max 1.2h, peak MaxRSS 5GB, CPU efficiency 5-7% - the cores a 32GB request brings
        // sit idle while still being billed. 12GB (~14 cores) leaves >2x memory headroom and
        // 4h >3x the longest run; an OOM (137) or walltime kill is in the retry range and the
        // retry goes back to the old 32GB with 12h.
        memory = { task.attempt > 1 ? 32.GB : 12.GB }
        time = { task.attempt > 1 ? '12h' : '4h' }
        errorStrategy = { task.exitStatus in (130..145) && task.attempt <= 1 ? 'retry' : 'ignore' }
        maxRetries = 1
    }
    withName: TRACS_ALIGN {
        container = 'zunairkhm/tracs-align:v4.0'
        cpus = 8   // nominal only - pawsey grants cpus in proportion to memory regardless
                   // of this value (measured: 20GB request -> billed/allocated ~24 cores).
                   // main.nf reads the real count via `nproc`, not this directive.
        //
        // With the read screen (main.nf) the alignment stage is one minimap2 pass over the
        // reads against all matched references plus small per-reference alignments, so
        // runtime no longer tracks references x input GB. Measured Oct 2026 on identical
        // reads (old code -> patched): 8 refs/1.4GB 9 -> 6 min; 39 refs/3.2GB 69 -> 25 min;
        // 179 refs/3.4GB 142 -> 18 min; 261 refs/2.9GB >120 (cancelled) -> 29 min;
        // 145 refs/10GB >120 (cancelled) -> 67 min. 12h therefore covers the largest inputs
        // seen (33GB, 573 refs) several times over; a retry gets 24h and 60GB (an OOM or a
        // walltime kill means the sample is an outlier), and only a third attempt goes to
        // `long` - it allows 4 jobs at a time and is far too scarce to spend earlier. 20GB
        // was never exceeded in validation (Slurm MaxRSS reads the 20GB limit on every run
        // above ~3GB of input because it counts page cache, so it is not a usage measure).
        memory = { task.attempt > 1 ? 60.GB : 20.GB }
        // Walltime kills surface as a signal exit status, not a fixed code - observed both
        // 143 (SIGTERM) and 140 (SIGUSR2, pawsey's pre-timeout warning) - hence matching
        // the whole range, which also includes 137 (OOM).
        queue = { task.attempt > 2 ? 'long' : 'work' }
        time  = { task.attempt > 2 ? '96h' : (task.attempt > 1 ? '24h' : '12h') }
        errorStrategy = { task.exitStatus in (130..145) && task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries = 2
    }
}

// Pipeline manifest
manifest {
    name        = 'meatgenomic_qc'
    description = 'A Nextflow pipeline for metagenomic preprocessing'
    version     = '1.0.0'

    contributors = [
        [
            name        : 'Khurram Zunair',
            affiliation : '',
            email       : '',
            github      : '',
            contribution: ['author', 'maintainer'],
            orcid       : ''
        ]
    ]
}

//setting for local use
/*docker {
    enabled = true
    //runOptions = '--platform linux/amd64'
}apptainer.registry   = 'quay.io'
process {
    executor = 'local'
    cpus = 12
    memory = '16 GB'
    time = '1h'
    containerOptions = '--platform linux/amd64'
}*/
