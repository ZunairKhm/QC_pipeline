// nextflow.config

//main options to change
params.outdir = "${baseDir}/results"
params.deacon_index = '../databases/deacon_index/panhuman-1.k31w15.idx'
params.nohuman_db = '../databases/nohuman/'
params.sylph_95_db = '../databases/sylph_databases/gtdb_95_DB/gtdb-r220-c200-dbv1.syldb'
params.sylph_99_db = '../databases/sylph_databases/gtdb_99_ordered_DB/gtdb_ordered_99.syldb'
params.kraken2_db = '../databases/kraken2_database/'
params.tracs_refseqs = '../databases/gtdb_genomes_reps_r220/database'
params.tracs_database = '../databases/gtdb-reps-rs220-k51.sbt.zip'
// Where TRACS_ALIGN changes gear, in work_units (references x input GB, measured by
// TRACS_GATHER). Derived from the fitted runtime model - see withName: TRACS_ALIGN below.
// Re-fit from results/metadata/tracs_sizing*.tsv against observed runtimes to retune.
params.tracs_work_boost = 4560   // above this, 2 workers miss 24h -> 5 workers, still on `work`
params.tracs_work_long  = 8361   // above this, 5 workers miss 24h too -> `long`
workDir = "${baseDir}/work"



//enables apptainer support
singularity {
    enabled = true
    autoMounts = true
    cacheDir  = "${baseDir}/singularity"
    envWhitelist = 'SINGULARITY_BINDPATH, SINGULARITYENV_LD_LIBRARY_PATH, SINGULARITYENV_LD_PRELOAD'
    }

//intermediary file cleanup using nf-boost; does not work consistently on slurm :(
/*plugins {
  id 'nf-boost'
}
boost {
  cleanup = 'v2'
}
boost.cleanupInterval = '180s'*/

//cleanup = true //enables nextflow built-in cleanup
executor {
    exitReadTimeout   = '30 min'
    queueStatInterval = '2 min'
    pollInterval      = '30 sec'
    submitRateLimit   = '20/1min'   // also addresses the 23 submit failures
    queueSize = 1024
}

params.slurm_account = 'pawsey1172'
// Slurm executor settings
process {
  cache = 'lenient' //apparently important in pawsey due to lustre?
  stageInMode = 'symlink'
  executor = 'slurm'
  clusterOptions = "--account=${params.slurm_account}"
  errorStrategy = 'ignore'
  beforeScript = 'module load pawseyenv/2025.08 && module load singularity/4.1.0-slurm' //load singularity on each job before running
  // Set resource requests
  cpus = 8
  memory = '16 GB'
  time = '30min'
  //container settings
  
  withName: KINGFISHER_ANNOTATE {
        container = 'zunairkhm/kingfisher-ascp:v1.0'
        cpus = 1
        memory = '4 GB'
        time = '1h'
    }
  withName: KINGFISHER_GET {
        //clusterOptions = "--partition=copy" //use copy partition for data transfer
        container = 'zunairkhm/kingfisher-ascp:v1.0'
        cpus = 8
        memory = '16 GB'
        // stay at 30min on every attempt unless the previous one was killed for running
        // out of walltime (signal exit codes 130-145, same range TRACS_ALIGN matches) -
        // a non-timeout failure (e.g. exit 1, access denied) won't be fixed by more time
        time = { task.exitStatus in (130..145) ? '1d' : '30m' }

    }
    withName: DEACON_FILTER {
        container = 'zunairkhm/deacon-image:v1.0'
    }
    withName: NOHUMAN_FILTER {
        container = 'zunairkhm/nohuman-image:v1.0'
        time = '1h'
        memory = '8 GB'
    }
    withName: SYLPH_QUERY {
        memory = '32 GB'
    }
    withName: KRAKEN2_KRAKEN2 {
    cpus = 16
    memory = '110 GB'
    time = '2h'
    container = 'quay.io/biocontainers/kraken2:2.1.3--pl5321hdcf5f25_0'
}
    withName: TRACS_GATHER {
        container = 'zunairkhm/tracs-align:v3.0'
        cpus = 8   // nominal - see the note on TRACS_ALIGN below
        // Dominated by sketching the reads, not by the gather: measured ~1.3 min per GB of
        // input, so 2h covers the largest inputs seen (~22GB) several times over. Memory is
        // for fastgather holding the 3GB database; sketching itself streams.
        memory = '32 GB'
        time = '2h'
    }
    withName: TRACS_ALIGN {
        container = 'zunairkhm/tracs-align:v3.0'
        cpus = 8   // nominal only - pawsey grants cpus in proportion to memory regardless
                   // of this value (measured: 20GB request -> billed/allocated ~24 cores).
                   // main.nf reads the real count via `nproc`, not this directive.
        //
        // Everything below is driven by work_units (references x input GB), which
        // TRACS_GATHER measures before this process starts. Fitted on 759 completed aligns:
        //     hours ~ 0.33 + 0.00431 * work_units      (r=0.987)
        // The thresholds are that model solved for 20h - deliberately short of the 24h cap,
        // since the fit slightly under-predicts the longest jobs - at 2 workers
        // (tracs_work_boost) and at 5 (tracs_work_long, using the benchmarked 1.82x).
        //
        // Below tracs_work_boost: 2 workers fit in 24h on `work`, which is where all but a
        // handful of samples land. Between the two: 5 workers bring it back under 24h, so it
        // still runs on `work` - `long` allows only 4 jobs at a time and is far too scarce to
        // spend on a job that does not need it. Above tracs_work_long: no worker count saves
        // it, so it goes straight to `long` rather than burning 24h proving that first.
        //
        // 20GB covers the read-size distribution (median 1.4GB, p90 4.2GB, p99 12.1GB); the
        // boosted tier jumps to 60GB because it also runs TRACS_ALIGN_WORKERS=5 - benchmarked
        // peak 50.7GB at W=5 vs 25GB at W=2, and 36GB was tested to OOM at W=5 (see
        // prod_candidate.sbatch).
        memory = { task.attempt > 1 || work_units >= params.tracs_work_boost ? 60.GB : 20.GB }
        // A retry means the estimate came in low, or the job OOMed, so it takes the top tier
        // regardless of what it was sized at. Walltime kills surface as a signal exit status,
        // not a fixed code - observed both 143 (SIGTERM) and 140 (SIGUSR2, pawsey's
        // pre-timeout warning) - hence matching the whole range, which also includes 137 (OOM).
        queue = { task.attempt > 1 || work_units >= params.tracs_work_long ? 'long' : 'work' }
        time  = { task.attempt > 1 || work_units >= params.tracs_work_long ? '96h' : '24h' }
        errorStrategy = { task.exitStatus in (130..145) && task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries = 2
    }
}

// Pipeline manifest
manifest {
    name        = 'meatgenomic_qc'
    description = 'A Nextflow pipeline for metagenomic preprocessing'
    version     = '1.0.0'

    contributors = [
        [
            name        : 'Khurram Zunair',
            affiliation : '',
            email       : '',
            github      : '',
            contribution: ['author', 'maintainer'],
            orcid       : ''
        ]
    ]
}

//setting for local use
/*docker {
    enabled = true
    //runOptions = '--platform linux/amd64'
}apptainer.registry   = 'quay.io'
process {
    executor = 'local'
    cpus = 12
    memory = '16 GB'
    time = '1h'
    containerOptions = '--platform linux/amd64'
}*/
