// nextflow.config

//main options to change
params.outdir = '/home/zkhurram/projectfolder/QC_pipeline/results'
params.deacon_index = "${baseDir}/data/panhuman-1.k31w15.idx"
params.sylph_95_db = '/home/zkhurram/projectfolder/sylph_databases/gtdb_95_DB/gtdb-r220-c200-dbv1.syldb'
params.sylph_99_db = '/home/zkhurram/projectfolder/sylph_databases/gtdb_99_ordered_DB/gtdb_ordered_99.syldb'
workDir = '/data/scratch/projects/punim2582/nextflow_work'

//enables apptainer support
apptainer {
    enabled = true
    autoMounts = true
    cacheDir  = '/data/projects/punim2582/QC_pipeline/singularity'
    }

//intermediary file cleanup using nf-boost; does not work consistently on slurm :(
/*plugins {
  id 'nf-boost'
}
boost {
  cleanup = 'v2'
}
boost.cleanupInterval = '180s'*/

cleanup = true

// Slurm executor settings
process {
  executor = 'slurm'
  // Set resource requests
  cpus = 8
  memory = '16 GB'
  time = '30min'
  //container settings
  container = 'zunairkhm/metagenomic_qc:v0.1'
    withName: DEACON_FILTER {
        container = 'zunairkhm/deacon-image:v1.0'
    }
    withName: SYLPH_QUERY {
        memory = '32 GB'
    }
}

// Pipeline manifest
manifest {
    name        = 'meatgenomic_qc'
    description = 'A Nextflow pipeline for FASTQ QC and Deacon filtering'
    version     = '1.0.0'

    contributors = [
        [
            name        : 'Khurram Zunair',
            affiliation : '',
            email       : '',
            github      : '',
            contribution: ['author', 'maintainer'],
            orcid       : ''
        ]
    ]
}

//setting for local use
/*docker {
    enabled = true
    //runOptions = '--platform linux/amd64'
}apptainer.registry   = 'quay.io'
process {
    executor = 'local'
    cpus = 12
    memory = '16 GB'
    time = '1h'
    containerOptions = '--platform linux/amd64'
}*/
